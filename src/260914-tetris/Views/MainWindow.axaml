<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600" Height="537"
        CanResize="False"
        x:Class="_260914_tetris.Views.MainWindow"
        Focusable="True"
        KeyDown="WindowKeyDown"
        Title="Avalonia Tetris!">

  <Grid Background="Azure" Margin="2,2,2,2">

    <Border x:Name="GameCanvasBorder"
            Width="208" Height="508"
            BorderBrush="LightBlue"
            BorderThickness="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,8"
            IsVisible="False">

      <Canvas x:Name="GameCanvas"
              Width="200" Height="500"
              Background="#000069"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              IsVisible="False" />

    </Border>
    <TextBlock x:Name="StartMessage"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Text="Press 'N' to play, press 'Q' to close the application."
               FontSize="16"
               Foreground="Black" />

    <Menu HorizontalAlignment="Left" VerticalAlignment="Top">
      <MenuItem Header="_Game">
        <MenuItem Header="_New" Click="OnNewGameClick" />
        <MenuItem Header="_Pause" Click="OnPauseClick" />
        <MenuItem Header="_Quit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="FAQ" Click="OnFAQClick" />
        <MenuItem Header="About" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <TextBlock
        x:Name="ScoreText"
        Text="Score: 0    "
        FontSize="14"
        Foreground="DarkBlue"
        Margin="5"
        HorizontalAlignment="Right" VerticalAlignment="Top"
        />

  </Grid>
</Window>
